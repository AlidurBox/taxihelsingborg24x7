# ============================================================
#  Taxi Helsingborg 24x7, inställningar för mejl
#  Kopiera till .env.local och fyll i. Starta om servern efter ändring.
# ============================================================

# --- Resend (https://resend.com) ---------------------------
# API-nyckel från Resend: API Keys > Create API Key
RESEND_API_KEY=

# --- Avsändare ---------------------------------------------
# Vem mejlen kommer från. Utan verifierad domän: använd onboarding@resend.dev.
# När domänen är verifierad i Resend, t.ex.:
# MAIL_FROM=Taxi Helsingborg 24x7 <bokning@taxihelsingborg24x7.se>
MAIL_FROM=Taxi Helsingborg 24x7 <onboarding@resend.dev>

# --- Mottagare ---------------------------------------------
# Hit skickas nya bokningar och företagsförfrågningar.
# Utan verifierad domän måste detta vara samma e-post som Resend-kontot.
MAIL_TO=

# --- Sajtens adress ----------------------------------------
# Används för loggan i mejlen. Sätt till adressen där sajten ligger live,
# t.ex. https://taxihelsingborg24x7.se eller Vercel-adressen.
SITE_URL=https://taxihelsingborg24x7.se
